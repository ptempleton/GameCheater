<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GameCheater.App.ViewModels"
        xmlns:models="clr-namespace:GameCheater.App.Models"
        xmlns:scanning="clr-namespace:GameCheater.Core.Scanning;assembly=GameCheater.Core"
        x:Class="GameCheater.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1150" Height="720"
        MinWidth="860" MinHeight="460"
        Title="GameCheater">

  <Grid RowDefinitions="Auto,*,Auto" Margin="14">

    <!-- Top bar: game picker + refresh + engine start/stop -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,0,0,12">
      <TextBlock Grid.Column="0" Text="Game" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
      <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="models:GameDef">
            <TextBlock Text="{Binding Display}"/>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0" HorizontalAlignment="Right">
        <TextBlock Text="{Binding AttachStatusText}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
        <TextBlock Text="{Binding ProcessName, StringFormat='{}{0}.exe'}" Foreground="Gray"
                   FontSize="10" HorizontalAlignment="Right"/>
      </StackPanel>
      <Button Grid.Column="3" Margin="0,0,8,0" Content="⟳ Refresh"
              Command="{Binding RefreshCommand}" ToolTip.Tip="Pull the latest trainers from the cheats repo"/>
      <Button Grid.Column="4" MinWidth="120" HorizontalContentAlignment="Center"
              Content="{Binding EngineButtonText}" Command="{Binding ToggleEngineCommand}"/>
    </Grid>

    <!-- Main: Cheats tab + Capture tab -->
    <TabControl Grid.Row="1">

      <TabItem Header="Cheats">
        <Grid ColumnDefinitions="*,6,300" Margin="0,8,0,0">
          <Border Grid.Column="0" BorderBrush="#33888888" BorderThickness="1" CornerRadius="8" Padding="4">
            <DockPanel>
              <!-- Game header -->
              <StackPanel DockPanel.Dock="Top" Margin="8,6,8,8">
                <TextBlock Text="{Binding SelectedGame.Display}" FontSize="20" FontWeight="Bold"/>
                <TextBlock Foreground="Gray" FontSize="11"
                           Text="{Binding ProcessName, StringFormat='{}{0}.exe'}"/>
              </StackPanel>

              <!-- Category filter chips -->
              <ListBox DockPanel.Dock="Top" Margin="6,0,6,8" Background="Transparent"
                       ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding}" Padding="4,1"/>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <!-- Cheats grouped by category, collapsible -->
              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding CheatGroups}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CheatGroupViewModel">
                      <Expander Header="{Binding Header}" IsExpanded="{Binding IsExpanded}"
                                IsVisible="{Binding IsVisible}" Margin="0,2" Padding="4,0">
                        <ItemsControl ItemsSource="{Binding Cheats}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CheatViewModel">
                              <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="4,4">
                                <TextBlock Grid.Column="0" Text="⚡" Foreground="#FFD24D"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                  <TextBlock Text="{Binding Description}" Foreground="Gray"
                                             FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Slider Grid.Column="2" Width="120" Margin="8,0" VerticalAlignment="Center"
                                        IsVisible="{Binding HasSlider}" Minimum="{Binding SliderMin}"
                                        Maximum="{Binding SliderMax}" Value="{Binding SliderValue}"/>
                                <TextBox Grid.Column="2" Width="88" Margin="8,0" VerticalAlignment="Center"
                                         IsVisible="{Binding HasValueBox}" Text="{Binding ValueText}" PlaceholderText="value"/>
                                <ComboBox Grid.Column="3" Width="70" Margin="6,0" VerticalAlignment="Center"
                                          ItemsSource="{Binding HotKeyOptions}" SelectedItem="{Binding HotKey}"
                                          ToolTip.Tip="Global hotkey to toggle this cheat"/>
                                <ToggleSwitch Grid.Column="4" VerticalAlignment="Center"
                                              OnContent="On" OffContent="Off" IsChecked="{Binding IsEnabled}"/>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Expander>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </Border>

          <GridSplitter Grid.Column="1" Background="Transparent"/>

          <DockPanel Grid.Column="2">
            <Button DockPanel.Dock="Top" x:Name="LoadTableButton" Margin="0,0,0,8"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Load .CT table…"/>
            <Border BorderBrush="#33888888" BorderThickness="1" CornerRadius="8" Padding="8">
              <ScrollViewer>
                <TextBlock Text="{Binding Report}" TextWrapping="Wrap"
                           FontFamily="Cascadia Code,Consolas,Menlo,monospace" FontSize="11"/>
              </ScrollViewer>
            </Border>
          </DockPanel>
        </Grid>
      </TabItem>

      <TabItem Header="Capture">
        <Grid x:DataType="vm:CaptureViewModel" DataContext="{Binding Capture}"
              RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="0,8,0,0">

          <!-- first scan -->
          <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,0,0,6">
            <TextBlock Grid.Column="0" Text="Type" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox Grid.Column="1" Width="92" ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}"/>
            <TextBox Grid.Column="2" Margin="8,0" Text="{Binding FirstValue}" PlaceholderText="value (blank = unknown)"/>
            <Button Grid.Column="3" Content="First Scan" Command="{Binding FirstScanCommand}" Margin="0,0,6,0"/>
            <Button Grid.Column="4" Content="Unknown ?" Command="{Binding UnknownScanCommand}"/>
          </Grid>

          <!-- narrow -->
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
            <Button Content="- decreased" Command="{Binding DecreasedCommand}"/>
            <Button Content="+ increased" Command="{Binding IncreasedCommand}"/>
            <Button Content="~ changed" Command="{Binding ChangedCommand}"/>
            <Button Content="= unchanged" Command="{Binding UnchangedCommand}"/>
            <TextBox Width="80" Text="{Binding NarrowValue}" PlaceholderText="exact"/>
            <Button Content="= value" Command="{Binding ExactNarrowCommand}"/>
            <Button Content="Reset" Command="{Binding ResetCommand}"/>
          </StackPanel>

          <TextBlock Grid.Row="2" Margin="0,0,0,4" Foreground="Gray"
                     Text="{Binding CandidateCount, StringFormat='{}{0:N0} candidates (change the value in-game, then narrow)'}"/>

          <Border Grid.Row="3" BorderBrush="#33888888" BorderThickness="1" CornerRadius="6">
            <ListBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="scanning:ScanCandidate">
                  <TextBlock Text="{Binding Display}" FontFamily="Cascadia Code,Consolas,Menlo,monospace" FontSize="12"/>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>

          <!-- capture actions -->
          <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,8,0,0">
            <TextBox Grid.Column="0" Width="84" Text="{Binding FreezeValue}" PlaceholderText="freeze val"/>
            <TextBox Grid.Column="1" Margin="8,0" Text="{Binding CheatName}" PlaceholderText="cheat name (e.g. Unlimited Fuel)"/>
            <Button Grid.Column="2" Content="Freeze" Command="{Binding FreezeCommand}" Margin="0,0,6,0"/>
            <Button Grid.Column="3" Content="Save as cheat" Command="{Binding SaveCommand}"/>
          </Grid>

          <TextBlock Grid.Row="5" Margin="0,6,0,0" Foreground="Gray" TextWrapping="Wrap" Text="{Binding Status}"/>
        </Grid>
      </TabItem>
    </TabControl>

    <!-- Status bar -->
    <Border Grid.Row="2" Background="#22888888" CornerRadius="6" Padding="10,6" Margin="0,12,0,0">
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
    </Border>
  </Grid>
</Window>
