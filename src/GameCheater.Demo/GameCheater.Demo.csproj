<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>GameCheater.Demo</RootNamespace>
    <AssemblyName>GameCheater.Cli</AssemblyName>
    <!-- The [LibraryImport] source generator emits unsafe marshalling stubs (same as Core). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameCheater.Core\GameCheater.Core.csproj" />
  </ItemGroup>

</Project>
