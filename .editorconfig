root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{cs,csx}]
indent_size = 4
# Treat unused usings and a few common code-smells as build-breaking so `dotnet format`
# and CI actually enforce them rather than warn.
dotnet_diagnostic.IDE0005.severity = warning   # unnecessary using directives
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true

[*.{csproj,props,targets,xml}]
indent_size = 2

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
